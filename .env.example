# The merchants think through any OpenAI compatible chat endpoint. Place your own key here; it never leaves this file.
LLM_BASE_URL=https://cloud-api.near.ai/v1
LLM_MODEL=Qwen/Qwen3.8-27B
LLM_API_KEY=
# near-ai: the answer is signed by the NEAR AI Cloud TEE and the contract trusts the key from its attestation report, registered after the Intel TDX quote verifies.
# worker: the worker signs with WORKER_SIGNING_SEED (32 bytes of hex), for any other OpenAI compatible endpoint; the contract labels those answers worker:<model>.
SIGN_MODE=near-ai
WORKER_SIGNING_SEED=
